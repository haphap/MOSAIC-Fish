# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== 图记忆后端（默认 Neo4j Community Edition，取代 Zep Cloud）=====
GRAPH_MEMORY_BACKEND=neo4j
# 本机直跑后端时用 localhost；docker compose 会自动覆盖为服务名 neo4j。
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofishdev

# ===== Embedding（OpenAI 格式 /embeddings；默认可复用 LLM 凭证）=====
# 需用支持自定义维度的模型：dashscope text-embedding-v4 或 OpenAI text-embedding-3-small。
# 维度必须与首次建库时一致（建好向量索引后不要再改 EMBEDDING_DIMENSIONS）。
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIMENSIONS=1536

# ===== Zep Cloud（可选；仅 GRAPH_MEMORY_BACKEND=zep 回退对照时需要）=====
# ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
